# AI providers (at least one recommended)

GEMINI_API_KEY=

GROQ_API_KEY=



# Optional search APIs (otherwise DuckDuckGo is used)

SERPER_API_KEY=

BRAVE_SEARCH_API_KEY=

TAVILY_API_KEY=



# Google Sign-In (OAuth 2.0 Web client — see README)
# Same client is reused for Gmail connect (extra scopes: gmail.send + gmail.readonly).
# In Google Cloud Console → OAuth consent, enable Gmail API and add those scopes.

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

JWT_SECRET=change-me-to-a-long-random-string

APP_URL=http://localhost:3000



# Set AUTH_DISABLED=1 to skip Google login during local dev

AUTH_DISABLED=



# Database
# Local development: SQLite file (fine for one machine).
DATABASE_URL=sqlite:///./nexivoreach.db
# Production / multi-device (Render): use managed Postgres.
# Render injects DATABASE_URL automatically when a Postgres DB is linked.
# Example: postgresql://user:pass@host:5432/nexivoreach

PYTHON_ENV=development


# ── Google Sheets Integration (optional) ────────────────────────────────────
# Paste the full JSON of your Google service-account key as a single line
# (replace newlines with \n inside the string).
# Share your spreadsheet with the service account email.

GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# The ID of the spreadsheet to write to (the long string in the URL)
GOOGLE_SHEETS_SPREADSHEET_ID=

