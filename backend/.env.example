# AI providers (at least one recommended)

GEMINI_API_KEY=

GROQ_API_KEY=



# Optional search APIs (otherwise DuckDuckGo is used)

SERPER_API_KEY=

BRAVE_SEARCH_API_KEY=

TAVILY_API_KEY=



# Google Sign-In (OAuth 2.0 Web client — see README)
# Same client is reused for Gmail connect (extra scopes: gmail.send + gmail.readonly).
# In Google Cloud Console → OAuth consent, enable Gmail API and add those scopes.

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

JWT_SECRET=change-me-to-a-long-random-string

APP_URL=http://localhost:3000

# Comma-separated emails that are always admins (and can sign up when invite-only).
ADMIN_EMAILS=

# When true, new Google accounts must be on the invite allowlist (Admin → Invites).
INVITE_ONLY=true

# Default daily caps per non-admin user (UTC day). Override per user in Admin.
DAILY_HUNT_LIMIT=5
DAILY_EXTRACT_LIMIT=10
DAILY_PREPARE_LIMIT=50
DAILY_SEND_LIMIT=40



# Set AUTH_DISABLED=1 to skip Google login during local dev

AUTH_DISABLED=



# Database
# Local development: SQLite file (fine for one machine).
DATABASE_URL=sqlite:///./nexivoreach.db
# Production / multi-device (Render): use managed Postgres.
# Render injects DATABASE_URL automatically when a Postgres DB is linked.
# Example: postgresql://user:pass@host:5432/nexivoreach

PYTHON_ENV=development


# ── Google Sheets Integration ───────────────────────────────────────────────
# Preferred: users click “Connect Google Sheets” (OAuth into their Drive).
# Requires the same GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET as login, with
# Sheets + Drive File scopes on the OAuth consent screen.
# Enable Google Sheets API and Google Drive API in Cloud Console.

# Optional legacy fallback (not needed if users use Connect Google Sheets):
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

